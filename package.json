{
  "name": "ohne",
  "version": "0.0.1",
  "description": "A zero-dependency TypeScript framework for the web.",
  "homepage": "https://ohne.dev",
  "license": "MIT",
  "author": "Muris Ceman <muris@ohne.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murisceman/ohne.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/ohne/index.ts",
      "default": "./src/ohne/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./utils/env": {
      "types": "./src/utils/env/index.ts",
      "default": "./src/utils/env/index.ts"
    },
    "./utils/fs": {
      "types": "./src/utils/fs/index.ts",
      "default": "./src/utils/fs/index.ts"
    },
    "./utils/print": {
      "types": "./src/utils/print/index.ts",
      "default": "./src/utils/print/index.ts"
    }
  },
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "node --test 'tests/**/*.test.ts'",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "engineStrict": true,
  "packageManager": "pnpm@11.5.1"
}
