{
  "name": "ohne",
  "version": "0.0.1",
  "description": "A zero-dependency TypeScript framework for the web.",
  "homepage": "https://ohne.dev",
  "license": "MIT",
  "author": "Muris Ceman <muris@ohne.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murisceman/ohne.git"
  },
  "bin": {
    "ohne": "./src/ohne/cli/bin.js"
  },
  "files": [
    "src",
    "ohne.config.ts",
    "ohne.layer.ts",
    "tsconfig.browser.json",
    "tsconfig.node.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/ohne/index.ts",
      "default": "./src/ohne/index.ts"
    },
    "./auth": {
      "types": "./src/layer/auth/index.ts",
      "default": "./src/layer/auth/index.ts"
    },
    "./dashboard": {
      "types": "./src/dashboard/index.ts",
      "default": "./src/dashboard/index.ts"
    },
    "./register": "./src/ohne/runtime/register.js",
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./utils/ansi": {
      "types": "./src/utils/ansi/index.ts",
      "default": "./src/utils/ansi/index.ts"
    },
    "./utils/cli": {
      "types": "./src/utils/cli/index.ts",
      "default": "./src/utils/cli/index.ts"
    },
    "./utils/codegen": {
      "types": "./src/utils/codegen/index.ts",
      "default": "./src/utils/codegen/index.ts"
    },
    "./utils/crypto": {
      "types": "./src/utils/crypto/index.ts",
      "default": "./src/utils/crypto/index.ts"
    },
    "./utils/env": {
      "types": "./src/utils/env/index.ts",
      "default": "./src/utils/env/index.ts"
    },
    "./utils/etag": {
      "types": "./src/utils/etag/index.ts",
      "default": "./src/utils/etag/index.ts"
    },
    "./utils/fs": {
      "types": "./src/utils/fs/index.ts",
      "default": "./src/utils/fs/index.ts"
    },
    "./utils/imports": {
      "types": "./src/utils/imports/index.ts",
      "default": "./src/utils/imports/index.ts"
    },
    "./utils/net": {
      "types": "./src/utils/net/index.ts",
      "default": "./src/utils/net/index.ts"
    },
    "./utils/print": {
      "types": "./src/utils/print/index.ts",
      "default": "./src/utils/print/index.ts"
    },
    "./tsconfig.browser.json": "./tsconfig.browser.json",
    "./tsconfig.node.json": "./tsconfig.node.json"
  },
  "scripts": {
    "dev": "node src/ohne/cli/bin.js dev",
    "format": "oxfmt",
    "lint": "oxlint",
    "serve:api": "node src/ohne/cli/bin.js serve api",
    "serve:dashboard": "node src/ohne/cli/bin.js serve dashboard",
    "test": "NODE_COMPILE_CACHE=node_modules/.cache/node-compile node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc && tsc -p src/dashboard/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "engineStrict": true,
  "packageManager": "pnpm@11.5.1"
}
